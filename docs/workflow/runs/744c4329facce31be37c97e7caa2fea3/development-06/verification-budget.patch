+func TestVerificationGateContext(test *testing.T) {
+	started := time.Now()
+	ctx, cancel := verificationGateContext(context.Background())
+	defer cancel()
+	deadline, bounded := ctx.Deadline()
+	if !bounded || deadline.Before(started.Add(24*time.Minute)) || deadline.After(time.Now().Add(24*time.Minute)) {
+		test.Fatal("gate must retain a bounded 24-minute cumulative budget")
+	}
+	parent, parentCancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
+	defer parentCancel()
+	child, childCancel := verificationGateContext(parent)
+	defer childCancel()
+	parentDeadline, _ := parent.Deadline()
+	childDeadline, _ := child.Deadline()
+	if !childDeadline.Equal(parentDeadline) {
+		test.Fatal("gate extended the parent deadline")
+	}
+	var output bytes.Buffer
+	command := exec.CommandContext(child, "/bin/sh", "-c", "sleep 30 & wait")
+	code, err := execute(child, command, &output)
+	if err == nil || code == 0 || child.Err() != context.DeadlineExceeded || time.Since(started) > 8*time.Second {
+		test.Fatalf("gate deadline lost: code=%d err=%v", code, err)
+	}
+	if command.Process == nil || !ownedGroupAbsent(command.Process.Pid) {
+		test.Fatal("gate cancellation left its process group")
+	}
+}
